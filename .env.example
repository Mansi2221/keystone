# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone_dev_password
DATABASE_URL=postgresql://keystone:keystone_dev_password@localhost:5433/keystone

# Profile: local (Ollama), free (Groq), paid (OpenAI)
PROFILE=local

# Provider/model overrides (blank = use profile defaults)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-3.5-flash

# API keys (set the ones for your chosen profile)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (for PROFILE=local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cerbos
CERBOS_HOST=localhost
CERBOS_PORT=3593
CERBOS_HTTP_PORT=3592

# Langfuse
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_HOST=http://localhost:3001

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Seed
SEED_RANDOM_SEED=42
SEED_LLM_CACHE_DIR=.seed_cache

# App
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
