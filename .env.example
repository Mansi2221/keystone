# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone_dev_password
DATABASE_URL=postgresql+asyncpg://keystone:keystone_dev_password@localhost:5432/keystone

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cerbos
CERBOS_HOST=localhost
CERBOS_PORT=3593
CERBOS_HTTP_PORT=3592

# Langfuse
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_HOST=http://localhost:3001

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Seed
SEED_RANDOM_SEED=42
SEED_LLM_CACHE_DIR=.seed_cache

# App
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
